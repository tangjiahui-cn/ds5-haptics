npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 编辑器 / 系统
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 环境变量 / 临时文件
.env
.env.*
!.env.example
*.bak
*.tmp
coverage/

# 构建时自动生成
src/version.ts
